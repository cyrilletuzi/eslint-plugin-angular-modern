{
  "name": "eslint-plugin-angular-modern",
  "version": "1.0.1",
  "description": "ESLint rules for modern and safe Angular.",
  "keywords": [
    "angular",
    "eslint"
  ],
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/cyrilletuzi"
  },
  "homepage": "https://github.com/cyrilletuzi/eslint-plugin-angular-modern#readme",
  "bugs": {
    "url": "https://github.com/cyrilletuzi/eslint-plugin-angular-modern/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyrilletuzi/eslint-plugin-angular-modern.git"
  },
  "license": "MIT",
  "author": "Cyrille Tuzi",
  "type": "commonjs",
  "scripts": {
    "build": "rm -rf dist && tsc && cp src/package.json dist/package.json && cp src/LICENSE dist/LICENSE && cp src/README.md dist/README.md",
    "test": "echo \"Error: no test specified\" && exit 1",
    "release:major": "VERSION=major npm run release",
    "release:minor": "VERSION=minor npm run release",
    "release:patch": "VERSION=patch npm run release",
    "release": "if test $VERSION; then npm run build && cd src && npm version $VERSION --no-git-tag-version && git add package.json && cd .. && npm run build && git commit -m \"release\" && npm version $VERSION && git push; fi",
    "stage-release": "git push origin v$npm_package_version"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.8.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.58.1"
  }
}